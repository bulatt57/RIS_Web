{
  "info": {
    "_postman_id": "8b7d4c10-2026-4a08-9108-000000000008",
    "name": "TaskControl API — ЛР8 (Assignments REST)",
    "description": "Коллекция запросов для проверки ЛР8 (201, 400, 404, 409 и два PATCH). Базовый адрес: http://localhost:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "1. POST /api/assignments — Успешное создание (ожидание 201, id, number, New)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Ответ содержит id, number и status === New', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.number).to.be.a('string').and.not.empty;",
              "    pm.expect(json.status).to.eql('New');",
              "    pm.expect(json.assigneeUserId).to.be.null;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Проверить резервный канал связи на узле Б\",\n  \"departmentId\": 2,\n  \"description\": \"После грозы наблюдается затухание сигнала на резервной линии\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/assignments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "assignments"
          ]
        }
      }
    },
    {
